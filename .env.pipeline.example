# Copy to .env.pipeline (git-ignored) and fill in your own values. Nothing site-specific belongs in the repository.
OPENAI_API_KEY=local
LLM_API_URL=http://llm-host.example:11434/v1/chat/completions
LLM_MODEL=your-model
# Optional: time zone for run IDs and daily dates (default America/New_York).
# TZ=America/New_York
# The host data directory is set by HN_BRIEF_DATA_DIR in the shell or a Compose .env file
# (default ./data); Compose does not read it from this file.
